# Local dev server (run: turso dev --db-file data/coffee.db)
TURSO_DATABASE_URL=http://127.0.0.1:8080

# To use a remote Turso database instead, override with:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token

# Auth.js (Google OAuth)
AUTH_SECRET=           # openssl rand -base64 33
AUTH_GOOGLE_ID=        # Google OAuth client ID
AUTH_GOOGLE_SECRET=    # Google OAuth client secret
ADMIN_EMAILS=example@gmail.com   # comma-separated allowlist

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # test key (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # test secret (always passes)
